{
 "name": "Saldo Certo",
 "short_name": "Saldo Certo",
 "lang": "pt-BR",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#F1F4F1",
 "theme_color": "#0B6B4E",
 "share_target": {
  "action": "./compartilhar",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "fatura",
     "accept": [
      "application/pdf",
      ".pdf",
      "text/csv",
      ".csv",
      ".ofx",
      "text/plain"
     ]
    }
   ]
  }
 },
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}